# EterVerse Environment Variables Template
# Copy this file to .env.local for local development, and add these to Vercel for production.

# Next.js Application URL (Required for NextAuth in production)
# Example: https://eterverse.com
NEXTAUTH_URL="http://localhost:3000"

# Secret used to encrypt NextAuth session cookies
# Generate one via: openssl rand -base64 32
AUTH_SECRET="your_generated_secret_here"

# MongoDB Connection String (Atlas recommended)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/eterverse"

# Discord OAuth2 Credentials (for Authentication)
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"

# Admin Emails (Comma separated list of emails that have access to /admin)
# Example: admin@eterverse.com,owner@eterverse.com
ADMIN_EMAILS="your_discord_email@example.com"

# Groq API Key (For the AI Matchmaker semantic search)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Upstash QStash Token (For securely triggering the background Ping Cron Job)
QSTASH_TOKEN="ey..."
